PORT=5000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=leavedesk
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=24h

# Auth cookie / CORS
CLIENT_ORIGIN=http://localhost:5173
# Use "none" (requires HTTPS) only if client and API are on different sites
COOKIE_SAMESITE=lax
